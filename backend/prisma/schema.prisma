// Yantos Roastery — skema database.
//
// Desain ledger dipertahankan dari versi artifact: stok, HPP rata-rata,
// saldo kas, dan piutang TIDAK disimpan. Semuanya dihitung ulang oleh
// src/engine/compute.ts dari tabel LedgerEntry setiap kali dibaca.

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: DATABASE_URL lewat pooler transaksi (6543), DIRECT_URL lewat
  // session pooler (5432) untuk prisma migrate. Lokal: isi keduanya sama.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" untuk lokal, rhel-openssl-3.0.x untuk Vercel (Node 18+ di Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ---------------------------------------------------------------------------
// Master data (id lama dipertahankan: g_*, b_*, p_*, pr_*)
// ---------------------------------------------------------------------------

model GreenBean {
  id           String  @id
  name         String
  category     String  @default("")
  price        Decimal @default(0) @db.Decimal(14, 2) // harga referensi per kg
  minKg        Decimal @default(0) @db.Decimal(10, 3) // reorder green
  minRoastedKg Decimal @default(0) @db.Decimal(10, 3) // reorder roasted
  active       Boolean @default(true)

  recipeItems BlendRecipeItem[]
  products    Product[]         @relation("ProductBean")
  suppliers   SupplierGreen[]

  @@map("green_beans")
}

model Blend {
  id     String  @id
  name   String
  cogs   Decimal @default(0) @db.Decimal(14, 2) // COGS referensi per kg
  minKg  Decimal @default(0) @db.Decimal(10, 3)
  active Boolean @default(true)

  recipe   BlendRecipeItem[]
  products Product[]         @relation("ProductBlend")

  @@map("blends")
}

model BlendRecipeItem {
  id      String    @id @default(cuid())
  blendId String
  blend   Blend     @relation(fields: [blendId], references: [id], onDelete: Cascade)
  greenId String
  green   GreenBean @relation(fields: [greenId], references: [id])
  pct     Decimal   @db.Decimal(6, 3)

  @@map("blend_recipe_items")
}

model Pack {
  id     String  @id
  name   String
  unit   String  @default("pcs")
  price  Decimal @default(0) @db.Decimal(14, 2)
  minQty Decimal @default(0) @db.Decimal(10, 0)
  active Boolean @default(true)

  products  Product[]
  suppliers SupplierPack[]

  @@map("packs")
}

// Supplier (id s_*). Satu supplier bisa memasok banyak green bean & kemasan, dan satu item
// bisa dipasok banyak supplier (tabel penghubung di bawah). Transaksi beli menyimpan
// supplierId + nama supplier saat itu, jadi ganti nama supplier tidak mengubah riwayat.
model Supplier {
  id      String  @id
  name    String
  phone   String  @default("")
  address String  @default("")
  note    String  @default("")
  active  Boolean @default(true)

  greens SupplierGreen[]
  packs  SupplierPack[]

  @@map("suppliers")
}

model SupplierGreen {
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  greenId    String
  green      GreenBean @relation(fields: [greenId], references: [id], onDelete: Cascade)

  @@id([supplierId, greenId])
  @@index([greenId])
  @@map("supplier_greens")
}

model SupplierPack {
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  packId     String
  pack       Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([supplierId, packId])
  @@index([packId])
  @@map("supplier_packs")
}

enum ProductKind {
  roasted
  blend
}

model Product {
  id     String      @id
  name   String
  kind   ProductKind
  // beanId menunjuk GreenBean (kind=roasted) atau Blend (kind=blend).
  // Relasi dipisah supaya foreign key tetap valid.
  greenId String?
  green   GreenBean?  @relation("ProductBean", fields: [greenId], references: [id])
  blendId String?
  blend   Blend?      @relation("ProductBlend", fields: [blendId], references: [id])
  grams   Int
  price   Decimal     @db.Decimal(14, 2)
  group   String      @default("Lainnya")
  packId  String?
  pack    Pack?       @relation(fields: [packId], references: [id])
  active  Boolean     @default(true)

  @@map("products")
}

// Satu baris saja (id = "main"). shares & routine berbentuk daftar kecil
// yang selalu dibaca utuh, jadi disimpan sebagai JSON.
model Config {
  id        String  @id @default("main")
  bizName   String  @default("Yantos Roastery")
  basis     String  @default("kas") // "kas" | "op"
  savingPct Decimal @default(10) @db.Decimal(6, 3)
  savingMin Decimal @default(1000000) @db.Decimal(14, 2)
  shares    Json    @default("[]") // [{ label, pct }]
  routine   Json    @default("[]") // [{ label, amount }]

  @@map("config")
}

// ---------------------------------------------------------------------------
// Ledger
// ---------------------------------------------------------------------------

enum LedgerType {
  opening
  green_in
  pack_in
  roast
  blend
  usage
  adjust
  sale
  kas
}

model LedgerEntry {
  id      String     @id
  type    LedgerType
  date    String     @db.VarChar(10) // YYYY-MM-DD, sama seperti versi lama (urutan = string)
  at      DateTime   @default(now()) // waktu input, pemecah urutan di tanggal yang sama
  by      String     @default("") // nama pencatat SAAT entri dibuat (tidak ikut berubah bila akun ganti nama)
  byUserId String?   // akun pencatat; kosong untuk entri sebelum kolom ini ada
  deleted Boolean    @default(false) // hapus = soft delete, entri tidak pernah dihapus fisik
  // Field khusus per jenis (greenId, kg, total, paid, items, ...).
  // Bentuknya didefinisikan & divalidasi di src/engine/types.ts dan ledgerService.
  data    Json       @default("{}")

  @@index([date])
  @@index([type, date])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Akun & sesi login (PIN 4 angka, tanpa memilih nama — seperti parang-ops)
// ---------------------------------------------------------------------------

enum UserRole {
  admin // bisa mendaftarkan & mengelola akun lain
  staff
}

model User {
  id        String   @id
  // Unik (tanpa beda huruf besar/kecil) di antara akun yang belum dihapus — dicek di authService,
  // bukan constraint DB, supaya nama akun yang sudah dihapus bisa dipakai lagi.
  name      String // ditampilkan setelah masuk dan mengisi LedgerEntry.by
  pinHash   String // scrypt$<salt>$<hash>, lihat src/lib/pin.ts. PIN unik antar akun (dicek di authService)
  role      UserRole @default(staff)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  // Hapus akun = soft delete: active=false + deletedAt. Akun tidak tampil lagi dan tidak bisa
  // masuk, tapi ledger & riwayat aktivitas yang merujuk ke akun ini tetap terbaca.
  deletedAt DateTime?

  sessions Session[]

  @@map("users")
}

// id = sha256 dari token yang dipegang browser, jadi token asli tidak tersimpan di DB.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime // batas mutlak (12 jam sejak masuk)
  // Request terakhir. Sesi ditolak bila diam lebih dari IDLE_MINUTES (authService.ts).
  // Diperbarui paling sering tiap 30 detik supaya tidak menambah tulis di setiap request.
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Penanda versi data untuk cache hitungan di stateService.ts
// ---------------------------------------------------------------------------

// Satu baris (id = 1). `rev` dinaikkan oleh trigger Postgres setiap ada INSERT/UPDATE/DELETE
// di tabel master, config, atau ledger (migrasi 20261117000000_session_idle_data_rev).
// Server cukup membaca angka ini untuk tahu apakah hasil compute() di memori masih berlaku.
// Jangan diubah manual; trigger yang mengurusnya.
model DataRev {
  id  Int    @id @default(1)
  rev BigInt @default(0)

  @@map("data_rev")
}

// ---------------------------------------------------------------------------
// Riwayat aktivitas: siapa mengubah apa. Ditulis lewat src/lib/activity.ts di transaksi yang sama
// dengan perubahannya. TIDAK ikut dihitung engine, jadi sengaja tanpa trigger bump_data_rev.
// ---------------------------------------------------------------------------

model ActivityLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  userId   String? // null untuk catatan tanpa akun
  userName String // nama saat kejadian
  action   String // create | update | delete | archive | restore | mark_paid | pin | reset ...
  entity   String // greens | blends | packs | products | config | ledger | users | data
  entityId String?
  summary  String // kalimat siap tampil
  changes  Json? // { field: [lama, baru] } untuk perubahan

  @@index([at])
  @@index([userId, at])
  @@index([entity, at])
  @@map("activity_logs")
}
