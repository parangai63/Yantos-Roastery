# Salin ke .env (atau .env.development / .env.production) lalu isi. File .env* selain
# .env.example tidak ikut di-commit. Hanya variabel berawalan VITE_ yang terbaca di browser,
# dan nilainya ikut tertanam di hasil build — jangan taruh rahasia di sini.

# Alamat backend yang dipanggil dari browser.
# - Kosong (disarankan): request ke /api/... di domain yang sama.
#     dev  → diteruskan Vite ke VITE_API_PROXY_TARGET (lihat bawah)
#     prod → diteruskan rewrite di vercel.json ke backend
#   Tanpa CORS, karena browser hanya melihat satu domain.
# - Diisi (mis. https://backend-yantos-roastery.vercel.app): browser memanggil backend langsung.
#   Tanpa "/" di akhir dan tanpa "/api". Backend wajib mengizinkan origin frontend
#   lewat CORS_ORIGIN di backend/.env.
VITE_API_URL=

# Khusus `npm run dev`: ke mana Vite meneruskan /api. Default http://localhost:4000.
# Isi dengan URL backend Vercel bila ingin menjalankan UI lokal tanpa menyalakan backend.
VITE_API_PROXY_TARGET=http://localhost:4000
